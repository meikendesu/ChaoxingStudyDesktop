# 复制到项目根目录 .env；已有 .env 时仅补齐缺少的字段。
# 设置页切换 Provider 时会带出该 Provider 的默认接口与模型，可直接修改后保存。
# 与原脚本 AI_PROVIDERS 的 15 个配置标识一一对应（默认模型 / 接口）：
# zhipu          glm-4-flash                https://open.bigmodel.cn/api/paas/v4/chat/completions
# deepseek       deepseek-chat              https://api.deepseek.com/chat/completions
# deepseek_v4    deepseek-v4-pro            https://api.deepseek.com/chat/completions
# qwen           qwen-plus                  https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# doubao         doubao-lite-32k            https://ark.cn-beijing.volces.com/api/v3/chat/completions
# spark          spark-lite                 https://spark-api-open.xf-yun.com/v1/chat/completions
# kimi           moonshot-v1-8k             https://api.moonshot.cn/v1/chat/completions
# gpt            gpt-4o-mini                https://api.openai.com/v1/chat/completions
# gemini         gemini-2.0-flash           https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# groq           llama-3.3-70b-versatile    https://api.groq.com/openai/v1/chat/completions
# siliconflow    Qwen/Qwen3-8B              https://api.siliconflow.cn/v1/chat/completions
# yi             yi-lightning               https://api.lingyiwanwu.com/v1/chat/completions
# minimax        abab6.5s-chat              https://api.minimax.chat/v1/text/chatcompletion_v2
# stepfun        step-1-flash               https://api.stepfun.com/v1/chat/completions
# baichuan       Baichuan4                  https://api.baichuan-ai.com/v1/chat/completions
CX_AI_PROVIDER=zhipu
CX_AI_API_KEY=
CX_AI_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/chat/completions
# 填写账号已开通的模型标识；留空时设置页会按所选 Provider 带出默认值。
CX_AI_MODEL=

# 图片文字 OCR：另行安装 Tesseract 5 和 chi_sim、eng 语言包。
# 留空时检测 EXE 旁 ocr、当前用户/Program Files 的 Tesseract-OCR 和 PATH。
# 自定义路径相对于本 .env 所在目录；不要填写额外命令或参数。
CX_OCR_PATH=
