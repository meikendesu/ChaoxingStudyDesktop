<Window x:Class="Desktop.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="学习通助手" Icon="Branding/app.ico" Width="1320" Height="860" MinWidth="1040" MinHeight="720"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Background="#F3F6FA" Foreground="{StaticResource Ink}"
        WindowStartupLocation="CenterScreen" Loaded="OnLoaded" Closing="OnClosing" Closed="OnClosed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>
        <!-- 浏览器风格标签栏：左侧标识、中间配置标签、右侧新建/管理/删除入口。
             每个配置在下方 BrowserStage 中对应一个独立 WebView2 实例，切换只改显隐并复用实例。 -->
        <Border Background="#172B42" Padding="12,0">
            <DockPanel VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Branding/app-icon.png" Width="26" Height="26" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="学习通助手" Foreground="#C7D8EA" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button x:Name="NewProfileButton" Content="＋ 新建" Click="NewProfileClick" FontSize="12" Padding="10,6" Margin="0,0,6,0" />
                    <Button x:Name="ManageProfileButton" Content="管理" Click="ManageProfileClick" FontSize="12" Padding="10,6" Margin="0,0,6,0" />
                    <Button x:Name="DeleteProfileButton" Content="删除" Click="DeleteProfileClick" FontSize="12" Padding="10,6" Margin="0" />
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center" Margin="10,0,0,0">
                    <ItemsControl x:Name="ProfileTabs">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}" Tag="{Binding Id}" Click="ProfileTabClick" FontSize="12" ToolTip="切换到此配置">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Setter Property="Background" Value="#2B4A6F" />
                                            <Setter Property="Foreground" Value="#DCE8F6" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Padding" Value="14,8" />
                                            <Setter Property="Margin" Value="0,0,6,0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="#F3F6FA" />
                                                    <Setter Property="Foreground" Value="#172B42" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="16,16,16,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="370" /></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#DCE4ED" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <!-- 账户实例池容器：CourseBrowser 是默认配置的主实例，其余账户实例按需加入并隐藏。 -->
                    <Grid x:Name="BrowserStage">
                        <wv:WebView2 x:Name="CourseBrowser" />
                    </Grid>
                    <Border x:Name="LoadingPanel" Background="#F8FAFC" Padding="40">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="470">
                            <TextBlock Text="准备课程浏览器" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <TextBlock x:Name="LoadingText" Text="正在初始化 WebView2…" Foreground="{StaticResource Muted}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <DockPanel Grid.Column="2">
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Button x:Name="BackButton" Content="←" Click="BackClick" ToolTip="后退" IsEnabled="False" />
                    <Button x:Name="ReloadButton" Content="刷新" Click="ReloadClick" IsEnabled="False" />
                    <Button x:Name="HomeButton" Content="主页" Click="HomeClick" IsEnabled="False" />
                    <Button x:Name="MuteButton" Content="取消静音" Click="MuteClick" IsEnabled="False" />
                </WrapPanel>
            <TabControl x:Name="SidebarTabs" SelectionChanged="SidebarChanged" Background="White" BorderBrush="#DCE4ED" Padding="0">
                <TabItem Header="概览">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20">
                            <TextBlock Text="当前页面" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,14" />
                            <TextBlock x:Name="PageTitleText" Text="尚未读取页面" FontSize="15" Margin="0,0,0,18" />
                            <TextBlock Text="当前课程类型" Foreground="{StaticResource Muted}" />
                            <TextBlock x:Name="CourseTypeText" Text="待识别" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,18" />
                            <TextBlock Text="课程总体完成进度" FontWeight="SemiBold" />
                            <ProgressBar x:Name="CourseProgressBar" Maximum="100" Height="10" Margin="0,10,0,6" />
                            <TextBlock x:Name="CourseProgressText" Text="待确认：尚未读取完整章节目录" Foreground="{StaticResource Muted}" Margin="0,0,0,16" />
                            <TextBlock Text="音视频学习进度 · 当前课时" FontWeight="SemiBold" />
                            <ProgressBar x:Name="VideoProgressBar" Maximum="100" Height="10" Margin="0,10,0,6" />
                            <TextBlock x:Name="VideoProgressText" Text="待确认：尚未加载音视频时长" Foreground="{StaticResource Muted}" Margin="0,0,0,8" />
                            <TextBlock x:Name="ProgressUpdatedText" Text="每 2 秒读取；课程完成后重新加载统计" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,18" />
                            <TextBlock Text="总体比例按网页目录的已完成章节统计；音视频比例来自本地播放位置，不代表平台已记录完成。" Foreground="{StaticResource Muted}" Margin="0,0,0,18" />
                            <CheckBox x:Name="AutoAdvanceBox" Content="章节完成后自动进入下一节" IsChecked="True" Checked="AutoAdvanceChanged" Unchecked="AutoAdvanceChanged" Margin="0,0,0,12" />
                            <StackPanel Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="音视频完成阈值" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock x:Name="AdvancePercentLabel" Text="91%" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#2563EB" Width="48" />
                                </StackPanel>
                                <TextBlock Text="达到后检查章节完成标记，再推进章节或同章任务。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,4" />
                                <Slider x:Name="AdvancePercentSlider" Minimum="1" Maximum="100" Value="91" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="AdvancePercentChanged" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="音视频倍速" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="PlaybackRateBox" Width="72" SelectionChanged="PlaybackRateChanged" />
                                <TextBlock Text="×（默认 2 倍速）" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="8,0,0,0" />
                            </StackPanel>
                            <Button x:Name="StartStudyButton" Content="开始自动播放" Click="StartStudyClick" Style="{StaticResource PrimaryButton}" Margin="0,0,0,10" IsEnabled="False" />
                            <TextBlock x:Name="StudyStatusText" Text="等待开始" Margin="0,0,0,12" Foreground="{StaticResource Muted}" />
                            <Button x:Name="StartCourseFlowButton" Content="按课程执行自动流程" Click="StartCourseFlowClick" Margin="0,0,0,6" IsEnabled="False" />
                            <TextBlock x:Name="CourseFlowStatusText" Text="未启动课程流程；当前已打开的课程页面（带各个任务点）可直接执行，不会跳转页面" Margin="0,0,0,12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                            <TextBlock Text="检测到题目后自动填写，全部核验通过后自动提交。未识别或漏答时不提交；停止按钮同时停止答题和提交。" Margin="0,0,0,12" Foreground="{StaticResource Muted}" />
                            <Button x:Name="RestoreCourseButton" Content="恢复上次课程" Click="RestoreCourseClick" Visibility="Collapsed" Margin="0,0,0,10" />
                            <Button x:Name="StopButton" Content="停止自动流程与播放" Click="StopClick" Margin="0,0,0,10" IsEnabled="False" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem x:Name="SettingsTab" Header="设置">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20">
                            <TextBlock Text="模型配置" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,14" />
                            <TextBlock Text="模型提供商" Margin="0,0,0,7" />
                            <ComboBox x:Name="ProviderBox" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectionChanged="ProviderChanged" Padding="9" Margin="0,0,0,16" />
                            <TextBlock Text="接口地址（HTTPS chat/completions）" Margin="0,0,0,7" />
                            <TextBox x:Name="EndpointBox" Margin="0,0,0,12" />
                            <TextBlock Text="模型名称" Margin="0,0,0,7" />
                            <TextBox x:Name="ModelBox" Margin="0,0,0,12" />
                            <TextBlock Text="新的 API Key" Margin="0,0,0,7" />
                            <PasswordBox x:Name="ApiKeyBox" Padding="10" MaxLength="8192" BorderBrush="#D8E1EB" AutomationProperties.Name="API Key" />
                            <TextBlock x:Name="KeyStatusText" Text="未保存密钥" Margin="0,8,0,12" Foreground="{StaticResource Muted}" />
                            <TextBlock Text="配置统一保存到本地 .env。相同提供商留空密钥可保留原值；更换提供商时需填写新密钥。密钥不回显、不传入网页。" Margin="0,0,0,16" Foreground="{StaticResource Muted}" />
                            <TextBlock x:Name="EnvStatusText" Text="AI 配置：待读取根目录 .env" Margin="0,0,0,16" Foreground="{StaticResource Muted}" />
                            <Button x:Name="SaveSettingsButton" Content="保存设置" Click="SaveSettingsClick" Style="{StaticResource PrimaryButton}" Margin="0,0,0,10" />
                            <Button Content="删除当前提供商密钥" Click="DeleteKeyClick" Margin="0,0,0,10" />
                            <Border BorderBrush="#E1E7EF" BorderThickness="0,1,0,0" Padding="0,20,0,0" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="本机数据" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <TextBlock Text="模型密钥保存在 .env 中，请勿分享该文件。清除浏览器资料会退出此程序中的网页登录，不影响其他浏览器。" Foreground="{StaticResource Muted}" Margin="0,0,0,14" />
                                    <Button x:Name="ClearLoginButton" Content="清除本程序的浏览器资料…" Click="ClearLoginClick" Margin="0,0,0,12" IsEnabled="False" />
                                    <TextBlock x:Name="DataPathText" FontSize="11" Foreground="{StaticResource Muted}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="日志">
                    <DockPanel Margin="16">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                            <TextBlock Text="运行日志" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,8" />
                            <TextBlock Text="保留本次运行最近 50 条，不保存题干或登录数据。" Foreground="{StaticResource Muted}" Margin="0,0,0,12" />
                            <Button Content="清空日志" Click="ClearLogsClick" HorizontalAlignment="Left" />
                        </StackPanel>
                        <ListBox x:Name="LogList" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" FontSize="12" Margin="0,5" /></DataTemplate></ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.ItemContainerStyle>
                        </ListBox>
                    </DockPanel>
                </TabItem>
            </TabControl>
            </DockPanel>
        </Grid>
        <DockPanel Grid.Row="2" Margin="20,0" VerticalAlignment="Center">
            <TextBlock DockPanel.Dock="Right" Text="0.3.0  /  Windows 原生客户端" Foreground="{StaticResource Muted}" FontSize="11" />
            <TextBlock x:Name="StatusText" Text="正在准备…" Foreground="{StaticResource Muted}" FontSize="12" />
        </DockPanel>
    </Grid>
</Window>
