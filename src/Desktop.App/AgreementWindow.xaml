<Window x:Class="Desktop.App.AgreementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="用户协议" Icon="Branding/app.ico" Width="820" Height="640" MinWidth="640" MinHeight="460"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Background="#F3F6FA" Foreground="{StaticResource Ink}"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="用户协议" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="开发者：MEIKEN　　版本：v1.0　　生效日期：2026 年 11 月 17 日"
                       Foreground="{StaticResource Muted}" Margin="0,6,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="#FFF7E6" BorderBrush="#F2C46B" BorderThickness="1" CornerRadius="6"
                Padding="12" Margin="0,0,0,12">
            <TextBlock Foreground="#7A5200" TextWrapping="Wrap">
                本软件仅限个人复习用途，不得用于正式生产、商业运营或任何超出复习范围的场景。请完整阅读以下协议；点击下方"同意协议"后方可进入应用。
            </TextBlock>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#DCE4ED" BorderThickness="1" CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16">
                <TextBlock x:Name="AgreementText" TextWrapping="Wrap" FontSize="12.5" LineHeight="21" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="DeclineButton" Content="不同意并退出" Width="132" Height="40" Click="OnDecline" Margin="0,0,10,0" />
            <Button x:Name="AgreeButton" Content="同意协议" Width="132" Height="40" Style="{StaticResource PrimaryButton}"
                    Click="OnAgree" Margin="0" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
